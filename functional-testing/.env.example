# Copy to .env and fill in. All vars use the FUNC_ prefix.
#
# For an ephemeral local stack, prefer:
#   ./functional-testing/docker/run-compose-gate.sh
# which exports these automatically from Docker Compose.

# Staff portal API
FUNC_STAFF_API_BASE=http://127.0.0.1:18082

# Partner API (Tier-3)
FUNC_PARTNER_API_BASE=http://127.0.0.1:18083

# Keycloak / OIDC
FUNC_KEYCLOAK_BASE=http://127.0.0.1:18080
FUNC_KEYCLOAK_REALM=staff
FUNC_OIDC_CLIENT_ID=registry-staff-portal
FUNC_OIDC_CLIENT_SECRET=func-gate-client-secret
FUNC_OIDC_USERNAME=func-ft-e2e
FUNC_OIDC_PASSWORD=func-ft-e2e-pass

# TLS verification for httpx
FUNC_VERIFY_TLS=false

# Optional: registry Postgres DSN for DB assertions
# FUNC_REGISTRY_DSN=postgresql://registry_user:functest123@127.0.0.1:15432/registry

# Household internal_record_id (must exist in Household register)
FUNC_HOUSEHOLD_ID=h001

# Document upload bucket
FUNC_DOCUMENT_UPLOAD_BUCKET=documents

# Staff UI base URL (Playwright)
FUNC_UI_BASE=http://127.0.0.1:3000
