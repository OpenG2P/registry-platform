# Keep build contexts small and images clean. The base image Dockerfiles COPY
# the core/ apis/ celery/ source trees; exclude local caches / build junk.
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/
**/.venv/
**/node_modules/
**/.next/
.git/
.DS_Store
