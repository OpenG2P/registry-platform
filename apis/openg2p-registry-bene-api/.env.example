# Database Config
REGISTRY_BENE_PORTAL_API_DB_USERNAME="postgres"
REGISTRY_BENE_PORTAL_API_DB_PASSWORD="password"
REGISTRY_BENE_PORTAL_API_DB_HOSTNAME="localhost"
REGISTRY_BENE_PORTAL_API_DB_PORT=5432
REGISTRY_BENE_PORTAL_API_DB_DBNAME="registry_db"
# SQLAlchemy pool per process. Defaults are 5 / 10.
REGISTRY_BENE_PORTAL_API_DB_POOL_SIZE=5
REGISTRY_BENE_PORTAL_API_DB_POOL_MAX_OVERFLOW=10
REGISTRY_BENE_PORTAL_API_DB_POOL_PRE_PING=true
REGISTRY_BENE_PORTAL_API_DB_POOL_RECYCLE=1800

# MinIO Config
REGISTRY_BENE_PORTAL_API_MINIO_ENDPOINT="localhost:9000"
REGISTRY_BENE_PORTAL_API_MINIO_ACCESS_KEY="admin"
REGISTRY_BENE_PORTAL_API_MINIO_SECRET_KEY="secret"
# REGISTRY_BENE_PORTAL_API_MINIO_READ_ACCESS_KEY="readonly"
# REGISTRY_BENE_PORTAL_API_MINIO_READ_SECRET_KEY="readonly-secret"
REGISTRY_BENE_PORTAL_API_MINIO_SECURE="false"
REGISTRY_BENE_PORTAL_API_DOCUMENT_STORAGE_BACKEND="minio"