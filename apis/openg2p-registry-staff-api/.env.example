# Database Config
REGISTRY_STAFF_PORTAL_API_DB_USERNAME="postgres"
REGISTRY_STAFF_PORTAL_API_DB_PASSWORD="password"
REGISTRY_STAFF_PORTAL_API_DB_HOSTNAME="localhost"
REGISTRY_STAFF_PORTAL_API_DB_PORT=5432
REGISTRY_STAFF_PORTAL_API_DB_DBNAME="registry_db"
# SQLAlchemy pool per process (also used for master-data). Defaults are 5 / 10.
REGISTRY_STAFF_PORTAL_API_DB_POOL_SIZE=5
REGISTRY_STAFF_PORTAL_API_DB_POOL_MAX_OVERFLOW=10
REGISTRY_STAFF_PORTAL_API_DB_POOL_PRE_PING=true
REGISTRY_STAFF_PORTAL_API_DB_POOL_RECYCLE=1800

# MinIO Config
REGISTRY_STAFF_PORTAL_API_MINIO_ENDPOINT="localhost:9000"
REGISTRY_STAFF_PORTAL_API_MINIO_ACCESS_KEY="admin"
REGISTRY_STAFF_PORTAL_API_MINIO_SECRET_KEY="secret"
# REGISTRY_STAFF_PORTAL_API_MINIO_READ_ACCESS_KEY="readonly"
# REGISTRY_STAFF_PORTAL_API_MINIO_READ_SECRET_KEY="readonly-secret"
REGISTRY_STAFF_PORTAL_API_MINIO_SECURE="false"

# Register export queue
REGISTRY_STAFF_PORTAL_API_EXPORT_QUEUE_VISIBILITY_DAYS=2
REGISTRY_STAFF_PORTAL_API_EXPORT_BATCH_SIZE=2000
REGISTRY_STAFF_PORTAL_API_DOCUMENT_STORAGE_BACKEND="minio"

# Master Data API
REGISTRY_STAFF_PORTAL_API_MASTER_DATA_API_URL="http://localhost:8001"
# Optional client_credentials. Empty falls back to PARTNER_MGMT_ADMIN_*.
# REGISTRY_STAFF_PORTAL_API_MASTER_DATA_TOKEN_URL=""
# REGISTRY_STAFF_PORTAL_API_MASTER_DATA_CLIENT_ID=""
# REGISTRY_STAFF_PORTAL_API_MASTER_DATA_CLIENT_SECRET=""

# IAM Auth Config
REGISTRY_STAFF_PORTAL_API_AUTH_PROVIDER_API_URL="https://iam-service-url"
REGISTRY_STAFF_PORTAL_API_KEYCLOAK_CLIENT_ID="client-id"

# Redis-backed auth (refresh tokens + OAuth transaction state)
REGISTRY_STAFF_PORTAL_API_AUTH_REDIS_URL=redis://localhost:6379/0
REGISTRY_STAFF_PORTAL_API_AUTH_TRANSACTION_STORE_BACKEND=redis
# Refresh token TTL in Redis (default 1800 = 30 minutes)
REGISTRY_STAFF_PORTAL_API_AUTH_REFRESH_TOKEN_TTL_SECONDS=1800

# OpenG2P Audit Manager integration
# To enable: set both AUDIT_ENABLED=true AND AUDIT_MANAGER_URL.
# Default = disabled / no-op (no audits emitted).
REGISTRY_STAFF_PORTAL_API_AUDIT_ENABLED="false"
REGISTRY_STAFF_PORTAL_API_AUDIT_MANAGER_URL=""
REGISTRY_STAFF_PORTAL_API_AUDIT_TIMEOUT_SECONDS="2.0"
REGISTRY_STAFF_PORTAL_API_AUDIT_SOURCE="/openg2p/registry-staff-portal-api"
REGISTRY_STAFF_PORTAL_API_AUDIT_MODULE="registry-staff-portal-api"
# Also audit rejected anonymous calls (401/403). Set to "false" to skip
# anonymous attempts entirely.
REGISTRY_STAFF_PORTAL_API_AUDIT_ANONYMOUS_FAILURES="true"