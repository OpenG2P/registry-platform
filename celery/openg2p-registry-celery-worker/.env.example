# Registry Database
REGISTRY_CELERY_WORKERS_DB_USERNAME="postgres"
REGISTRY_CELERY_WORKERS_DB_PASSWORD="postgres"
REGISTRY_CELERY_WORKERS_DB_HOSTNAME="localhost"
REGISTRY_CELERY_WORKERS_DB_PORT=5432
REGISTRY_CELERY_WORKERS_DB_DBNAME="registrydb"
# SQLAlchemy pool per worker process (also used for master-data). Defaults are 5 / 10.
REGISTRY_CELERY_WORKERS_DB_POOL_SIZE=5
REGISTRY_CELERY_WORKERS_DB_POOL_MAX_OVERFLOW=10
REGISTRY_CELERY_WORKERS_DB_POOL_PRE_PING=true
REGISTRY_CELERY_WORKERS_DB_POOL_RECYCLE=1800

# Celery Configuration
REGISTRY_CELERY_WORKERS_CELERY_BROKER_URL="redis://localhost:6379/0"
REGISTRY_CELERY_WORKERS_CELERY_BACKEND_URL="redis://localhost:6379/0"
REGISTRY_CELERY_WORKERS_WORKER_QUEUE="registry_worker_queue"

REGISTRY_CELERY_WORKERS_BATCH_SIZE=2000
REGISTRY_CELERY_WORKERS_WORKER_MAX_ATTEMPTS=5

# MinIO Configuration
REGISTRY_CELERY_WORKERS_MINIO_ENDPOINT="localhost:9000"
REGISTRY_CELERY_WORKERS_MINIO_ACCESS_KEY="admin"
REGISTRY_CELERY_WORKERS_MINIO_SECRET_KEY="secret"
# REGISTRY_CELERY_WORKERS_MINIO_READ_ACCESS_KEY="readonly"
# REGISTRY_CELERY_WORKERS_MINIO_READ_SECRET_KEY="readonly-secret"
REGISTRY_CELERY_WORKERS_MINIO_SECURE=false
REGISTRY_CELERY_WORKERS_DOCUMENT_STORAGE_BACKEND="minio"

# Master Data Database 
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_DRIVER="postgresql+asyncpg"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_USERNAME="postgres"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_PASSWORD="password"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_HOSTNAME="localhost"
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_PORT=5432
REGISTRY_CELERY_WORKERS_MASTER_DATA_DB_DBNAME="masterdatadb"

REGISTRY_CELERY_WORKERS_FUNCTIONAL_ID_GENERATION_URL="http://functional-id-generation-service-url/v1"
REGISTRY_CELERY_WORKERS_ID_GENERATION_ALLOCATION_PATH="/idgenerator/{id_type}/id"
REGISTRY_CELERY_WORKERS_ID_GENERATION_UPDATION_PATH=""