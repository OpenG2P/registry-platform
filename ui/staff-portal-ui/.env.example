BACKEND_API_URL="https://staff-registry.dev.openg2p.org"
MASTERDATA_BACKEND_API_URL="https://master-data.dev.openg2p.org"
DEFAULT_LOCALE="en"

PARTNER_IMPORT_EXPORT_ENABLE="true"

VERIFY_SERVICE_URL="https://registry-farmer.dev.openg2p.org/v1/verify"
VP_CLIENT_ID="did:web:registry-farmer.dev.openg2p.org:v1:verify"

PAGE_SIZE=10

IAM_URL="http://iam.openg2p.my"
LOGIN_PROVIDER_ID="1"
APPLICATION_MNEMONIC="registry-staff-portal"
# Post-logout redirect is configured on the IAM login provider (default_redirect_uri), not in staff-portal-ui.

# Auto-logout after no user activity (milliseconds). Default: 1800000 (30 min). Set to 0 to disable.
SESSION_IDLE_TIMEOUT_MS=1800000