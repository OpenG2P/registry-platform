# Content-Security-Policy — one env var per directive (space-separated sources).
# CSP_SRC_DEFAULT=self
# CSP_SRC_SCRIPT=self unsafe-inline
# CSP_SRC_STYLE=self unsafe-inline
# CSP_SRC_IMG="self blob: data: https: http:"
# CSP_SRC_CONNECT="self http: https: ws: wss: "
# CSP_SRC_FRAME=self
# CSP_SRC_OBJECT=none
# CSP_SRC_BASE_URI=self
# CSP_SRC_FORM_ACTION=self
# CSP_SRC_FRAME_ANCESTORS=none

NOTIFICATION_PROVIDER="novu"
NOTIFICATION_APPLICATION_IDENTIFIER=""
NOTIFICATION_BACKEND_URL="https://novu-api.dev.openg2p.org"
NOTIFICATION_WEBSOCKET_URL="https://novu-api.dev.openg2p.org"
NOTIFICATION_SECRET_KEY=""

BACKEND_API_URL="https://staff-registry.dev.openg2p.org"
MASTERDATA_BACKEND_API_URL="https://master-data.dev.openg2p.org"
DEFAULT_LOCALE="en"

PARTNER_IMPORT_EXPORT_ENABLE="true"

# Point these at THIS deployment's own host. The platform serves every
# manifestation, so the example must not name one of them.
VERIFY_SERVICE_URL="https://registry.example.org/v1/verify"
VP_CLIENT_ID="did:web:registry.example.org:v1:verify"

PAGE_SIZE=10

IAM_URL="http://iam.openg2p.my"
LOGIN_PROVIDER_ID="1"
APPLICATION_MNEMONIC="registry-staff-portal"
# Dot-prefixed parent domain for auth cookies forwarded by the UI proxy (e.g. .openg2p.org)
COOKIE_DOMAIN=".openg2p.org"