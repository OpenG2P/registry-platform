# nginx config for the agent portal SPA.
# - Serves static files from /usr/share/nginx/html.
# - Falls back to /index.html for unknown paths so React-router deep links
#   (e.g. /policies/foo/versions/1/edit) don't 404.
# - Proxies `location /agent_portal/` to the Agent Portal API. This is LOAD
#   BEARING, in Kubernetes as much as in docker-compose: the SPA is served
#   config.json with an empty apiBaseUrl and therefore calls its own origin,
#   and the API sits on a DIFFERENT host (its own VirtualService), so nothing
#   upstream rewrites these paths. An earlier version of this file claimed
#   Istio routed /agent_portal/ before the request reached nginx; it does not,
#   and every API call 502'd.
# - The upstream is ${AGENT_API_UPSTREAM}, substituted at container start from
#   the environment (this file is installed as an nginx *template*). It must be
#   the real Service, which in Kubernetes is release-prefixed and on port 80 --
#   not the bare `agent-portal-api:8000` of the compose network.
# - proxy_pass is given a LITERAL host (envsubst has already replaced the
#   placeholder by the time nginx parses this), so nginx resolves it once at
#   startup through the system resolver and needs no `resolver` directive.
#   The alternative -- a variable upstream -- forces per-request resolution and
#   therefore a `resolver`, and there is no portable address to give it:
#   Docker's 127.0.0.11 does not exist under Kubernetes (every lookup failed
#   with "recv() failed (111: Connection refused) while resolving"), the DNS
#   Service name differs per distribution (rke2-coredns-rke2-coredns here), and
#   `resolver local=on` is nginx Plus only.
#   Trade-off: nginx will not start if the upstream name does not resolve. That
#   is acceptable because Service DNS resolves as soon as the Service object
#   exists, regardless of whether any API pod is ready yet.

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # The SPA's only route to its API — see the header.
    location /agent_portal/ {
        # No trailing path: the original /agent_portal/... URI is passed
        # through unchanged, which is what the API routes on.
        proxy_pass http://${AGENT_API_UPSTREAM};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Long cache for fingerprinted static assets (Vite emits hashed names).
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Anything else → SPA fallback. Prevents 404 on client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # No-cache for index.html so clients always re-check after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Standard gzip for the static JS/CSS/HTML the SPA ships.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
