{
  "section-id": "normal_section",
  "section-title": "Normal Section",
  "section-editable": true,
  "panels": [
    {
      "panel-id": "panel_personal_info_main",
      "panel-orientation": "horizontal",
      "panels": [
        {
          "panel-id": "panel_personal_info_1",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "date",
              "widget-id": "birth_date",
              "widget-type": "input",
              "widget-label": "Birth Date",
              "widget-data-path": "register-id.birth_date",
              "widget-required": true
            },
            {
              "widget": "number",
              "widget-id": "estimated_age",
              "widget-type": "input",
              "widget-label": "Estimated Age",
              "widget-data-path": "register-id.estimated_age"
            },
            {
              "widget": "select",
              "widget-id": "gender",
              "widget-type": "input",
              "widget-label": "Gender",
              "widget-data-path": "register-id.gender",
              "widget-required": true,
              "widget-data-source": {
                "type": "static",
                "options": [
                  { "label": "Male", "value": "male" },
                  { "label": "Female", "value": "female" },
                  { "label": "Other", "value": "other" }
                ]
              }
            }
          ]
        },
        {
          "panel-id": "panel_personal_info_2",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "select",
              "widget-id": "marital_status",
              "widget-type": "input",
              "widget-label": "Marital Status",
              "widget-data-path": "register-id.marital_status",
              "widget-required": true,
              "widget-data-source": {
                "type": "static",
                "options": [
                  { "label": "Single", "value": "single" },
                  { "label": "Married", "value": "married" },
                  { "label": "Divorced", "value": "divorced" },
                  { "label": "Widowed", "value": "widowed" }
                ]
              }
            },
            {
              "widget": "select",
              "widget-id": "education_level",
              "widget-type": "input",
              "widget-label": "Education Level",
              "widget-data-path": "register-id.education_level",
              "widget-data-source": {
                "type": "static",
                "options": [
                  { "label": "None", "value": "none" },
                  { "label": "Primary", "value": "primary" },
                  { "label": "Secondary", "value": "secondary" },
                  { "label": "Tertiary", "value": "tertiary" }
                ]
              }
            },
            {
              "widget": "text",
              "widget-id": "external_reference_id",
              "widget-type": "input",
              "widget-label": "External reference ID",
              "widget-data-path": "register-id.external_reference_id"
            }
          ]
        },
        {
          "panel-id": "panel_personal_info_3",
          "panel-orientation": "vertical",
          "widgets": [
            {
              "widget": "select",
              "widget-id": "has_personal_phone",
              "widget-type": "input",
              "widget-label": "Has Personal Phone",
              "widget-data-path": "register-id.has_personal_phone",
              "widget-data-format": { "layout": "vertical", "sortOptions": false },
              "widget-data-source": {
                "type": "static",
                "options": [
                  { "label": "Yes", "value": "yes" },
                  { "label": "No", "value": "no" }
                ]
              }
            },
            {
              "widget": "text",
              "widget-id": "phone",
              "widget-type": "input",
              "widget-label": "Phone",
              "widget-data-path": "register-id.phone",
              "widget-required": true
            },
            {
              "widget": "text",
              "widget-id": "email",
              "widget-type": "input",
              "widget-label": "Email",
              "widget-data-path": "register-id.email",
              "widget-data-validation": { "validationType": "email", "required": true }
            }
          ]
        }
      ]
    }
  ]
}
