{
  "widget": "register-lookup",
  "widget-type": "input",
  "widget-id": "linked_record",
  "widget-label": "Linked Record",
  "widget-data-path": "source-register-id.link_internal_record_id",

  // --- Single-source form (one tab, no tab bar rendered) ---
  "widget-data-source": {
    "type": "api",
    "method": "POST",
    "service": "register",
    "endpoint": "records",
    "params": {
      "register_id": "<target_register_id>"
    }
  },

  // --- Multi-source form (one tab per entry; tab bar rendered) ---
  // "widget-data-source": [
  //   {
  //     "type": "api",
  //     "method": "POST",
  //     "service": "register",
  //     "endpoint": "records",
  //     "params": { "register_id": "<target_register_id>" }
  //   },
  //   {
  //     "type": "api",
  //     "method": "POST",
  //     "service": "intake-form",
  //     "endpoint": "get-inflight-register-parents",
  //     "params": { "register_id": "<target_register_id>" }
  //   }
  // ],

  "widget-lookup-config": {
    "page_size": 10,
    "action_label": "Click to Search Record",
    "search_placeholder": "Search by name or ID...",
    "select_record_label": "Select Record"
  }

  // --- Optional flags ---
  // "widget-required": true,
  // "widget-readonly": false,

}
