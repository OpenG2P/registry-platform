{
  "widget": "iterable-accordion",
  "widget-type": "group",
  "widget-id": "notes",
  "widget-label": "Additional Notes",
  "widget-data-path": "register-id.notes",
  "widget-item": {
    "widget": "textarea",
    "widget-type": "input",
    "widget-id": "note",
    "widget-label": "Note",
    "widget-data-path": ".",
    "widget-data-format": { "rows": 3 }
  }

