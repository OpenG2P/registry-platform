{
  "name": "@openg2p/registry-widgets",
  "version": "1.1.4-dev.2",
  "type": "module",
  "description": "Complete React widget library with generic form widgets, data binding, validation, and conditional logic",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build",
    "example:setup": "npm install -D vite @vitejs/plugin-react && npm install react react-dom @reduxjs/toolkit react-redux zod json-edit-react",
    "example:dev": "vite",
    "example:build": "vite build"
  },
  "keywords": [
    "react",
    "widget",
    "form",
    "component",
    "typescript",
    "redux",
    "zod",
    "validation",
    "data-binding"
  ],
  "author": "",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenG2P/registry-platform.git",
    "directory": "ui/ui-widgets"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "glob": "^10.0.0",
    "inflight": "npm:@jsdevtools/inflight@^1.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "json-edit-react": "^1.30.2"
  }
}
